# Copy to .env and fill in. Any OpenAI-compatible endpoint works (OpenRouter, Google's OpenAI-compatible URL, ...).
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=your_model_name

# Optional: retrievers switched on by default in the UI/API (comma separated: dense,bm25,graph)
DEFAULT_RETRIEVERS=dense,bm25

# Optional: concept graph build (python -m app.graph build)
# GRAPH_LLM_MODEL=another_model_for_extraction
# GRAPH_CALL_DELAY_S=1.0
# GRAPH_DISABLE_THINKING=1
# Optional: switch hidden reasoning off for answers (reasoning models such as nemotron), DECISIONS D-35
LLM_DISABLE_THINKING=1
# Optional: completion token limit for answers (default 2048)
# LLM_MAX_TOKENS=2048

# Personal data redaction before the LLM call and the traces (DECISIONS D-37). 0 turns it off.
PII_REDACTION=1
# Optional: LLM prices in USD per million tokens, for the cost shown in traces (v4T02).
# Unset = cost 0, shown as "free tier". Tokens always come from the provider's usage field.
# LLM_PRICE_IN_PER_1M=0.50
# LLM_PRICE_OUT_PER_1M=1.50
# Optional: where traces are stored (default data/traces/traces.sqlite)
# TRACES_DB=data/traces/traces.sqlite
